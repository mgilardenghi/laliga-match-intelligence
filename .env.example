# Local environment template.
# Copy this file to .env (or run `make setup`) and never commit .env.
# The values below are placeholders; replace the password for your machine.

POSTGRES_USER=lmi
POSTGRES_DB=lmi
# Any character is accepted except a newline: the services build the database URL
# in code, so nothing here needs URL quoting.
POSTGRES_PASSWORD=change-me

# Optional football-data API key. Leave empty when it is not needed.
API_FOOTBALL_KEY=
